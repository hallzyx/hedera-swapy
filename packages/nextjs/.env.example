# Optional RPC override (defaults to Hashio testnet)
NEXT_PUBLIC_HEDERA_TESTNET_RPC_URL=https://testnet.hashio.io/api

# RainbowKit WalletConnect project id
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# Optional HCS receipt writer (server-only — never commit real values)
HCS_OPERATOR_ID=
HCS_OPERATOR_KEY=
HCS_TOPIC_ID=

# Address of a deployed TreasuryPolicyGuard (enables the Treasury guard panel and receipt target)
NEXT_PUBLIC_TREASURY_GUARD_ADDRESS=
